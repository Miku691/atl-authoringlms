<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ExpenseSummary" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isIgnorePagination="true">
    <property name="net.sf.jasperreports.export.xls.auto.fit.column" value="true"/>
    <property name="net.sf.jasperreports.export.xls.auto.fit.row" value="true"/>
    <property name="net.sf.jasperreports.export.xls.wrap.text" value="false"/>
    <property name="net.sf.jasperreports.export.xls.detect.cell.type" value="true"/>
    <property name="net.sf.jasperreports.export.xls.white.page.background" value="false"/>
    <property name="net.sf.jasperreports.export.xls.remove.empty.space.between.columns" value="true"/>
    <property name="net.sf.jasperreports.export.xls.remove.empty.space.between.rows" value="true"/>
    <property name="net.sf.jasperreports.print.keep.full.text" value="true"/>
    <property name="net.sf.jasperreports.export.csv.write.header" value="true"/>
    <property name="net.sf.jasperreports.export.xls.font.size.fix.enabled" value="false"/>

    <parameter name="param_tenant_id" class="java.lang.String"/>
    <queryString>
        <![CDATA[SELECT academic_year, category_name, yearly_month, expense_count, total_amount FROM v_expense_summary WHERE tenant_id = $P{param_tenant_id}]]>
    </queryString>
    <field name="academic_year" class="java.lang.String"/>
    <field name="category_name" class="java.lang.String"/>
    <field name="yearly_month" class="java.lang.String"/>
    <field name="expense_count" class="java.lang.Long"/>
    <field name="total_amount" class="java.math.BigDecimal"/>
    <columnHeader>
        <band height="26">
            <staticText><reportElement x="0" y="0" width="120" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font isBold="true" size="11"/></textElement><text><![CDATA[Academic Year]]></text></staticText>
            <staticText><reportElement x="120" y="0" width="200" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font isBold="true" size="11"/></textElement><text><![CDATA[Category]]></text></staticText>
            <staticText><reportElement x="320" y="0" width="120" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font isBold="true" size="11"/></textElement><text><![CDATA[Month (YYYY-MM)]]></text></staticText>
            <staticText><reportElement x="440" y="0" width="100" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font isBold="true" size="11"/></textElement><text><![CDATA[Count]]></text></staticText>
            <staticText><reportElement x="540" y="0" width="150" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font isBold="true" size="11"/></textElement><text><![CDATA[Total Amount]]></text></staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="26">
            <textField><reportElement x="0" y="0" width="120" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font size="10"/></textElement><textFieldExpression><![CDATA[$F{academic_year}]]></textFieldExpression></textField>
            <textField><reportElement x="120" y="0" width="200" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font size="10"/></textElement><textFieldExpression><![CDATA[$F{category_name}]]></textFieldExpression></textField>
            <textField><reportElement x="320" y="0" width="120" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font size="10"/></textElement><textFieldExpression><![CDATA[$F{yearly_month}]]></textFieldExpression></textField>
            <textField><reportElement x="440" y="0" width="100" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font size="10"/></textElement><textFieldExpression><![CDATA[$F{expense_count}]]></textFieldExpression></textField>
            <textField><reportElement x="540" y="0" width="150" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font size="10"/></textElement><textFieldExpression><![CDATA[$F{total_amount}]]></textFieldExpression></textField>
        </band>
    </detail>
</jasperReport>
