            <staticText><reportElement x="540" y="0" width="60" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font isBold="true" size="11"/></textElement><text><![CDATA[Amt Due]]></text></staticText>
            <staticText><reportElement x="600" y="0" width="60" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font isBold="true" size="11"/></textElement><text><![CDATA[Amt Paid]]></text></staticText>
            <staticText><reportElement x="660" y="0" width="60" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font isBold="true" size="11"/></textElement><text><![CDATA[Balance]]></text></staticText>
            <staticText><reportElement x="720" y="0" width="60" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font isBold="true" size="11"/></textElement><text><![CDATA[Late Fee]]></text></staticText>
