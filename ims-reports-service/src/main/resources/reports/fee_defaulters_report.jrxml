            <textField><reportElement x="80" y="0" width="100" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font size="10"/></textElement><textFieldExpression><![CDATA[$F{offering_name}]]></textFieldExpression></textField>
            <textField><reportElement x="180" y="0" width="80" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font size="10"/></textElement><textFieldExpression><![CDATA[$F{admission_no}]]></textFieldExpression></textField>
