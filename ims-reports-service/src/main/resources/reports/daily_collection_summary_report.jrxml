<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="DailyCollectionSummary" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isIgnorePagination="true">
    <property name="net.sf.jasperreports.export.xls.auto.fit.column" value="true"/>
    <property name="net.sf.jasperreports.export.xls.auto.fit.row" value="true"/>
    <property name="net.sf.jasperreports.export.xls.wrap.text" value="false"/>
    <property name="net.sf.jasperreports.export.xls.detect.cell.type" value="true"/>
    <property name="net.sf.jasperreports.export.xls.white.page.background" value="false"/>
    <property name="net.sf.jasperreports.export.xls.remove.empty.space.between.columns" value="true"/>
    <property name="net.sf.jasperreports.export.xls.remove.empty.space.between.rows" value="true"/>
    <property name="net.sf.jasperreports.print.keep.full.text" value="true"/>
    <property name="net.sf.jasperreports.export.csv.write.header" value="true"/>
    <property name="net.sf.jasperreports.export.xls.font.size.fix.enabled" value="false"/>

    <parameter name="param_tenant_id" class="java.lang.String"/>
    <parameter name="param_start_date" class="java.util.Date"/>
    <parameter name="param_end_date" class="java.util.Date"/>
    <queryString>
        <![CDATA[SELECT transaction_id, academic_year, first_name, last_name, admission_no, amount, payment_mode, reference_number, transaction_date FROM v_daily_collection_summary WHERE tenant_id = $P{param_tenant_id} AND ($P{param_start_date} IS NULL OR payment_date >= $P{param_start_date}) AND ($P{param_end_date} IS NULL OR payment_date <= $P{param_end_date})]]>
    </queryString>
    <field name="academic_year" class="java.lang.String"/>
    <field name="first_name" class="java.lang.String"/>
    <field name="last_name" class="java.lang.String"/>
    <field name="admission_no" class="java.lang.String"/>
    <field name="amount" class="java.math.BigDecimal"/>
    <field name="payment_mode" class="java.lang.String"/>
    <field name="reference_number" class="java.lang.String"/>
    <field name="transaction_date" class="java.sql.Timestamp"/>
    <columnHeader>
        <band height="26">
            <staticText><reportElement x="0" y="0" width="100" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font isBold="true" size="11"/></textElement><text><![CDATA[Transaction Date]]></text></staticText>
            <staticText><reportElement x="100" y="0" width="100" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font isBold="true" size="11"/></textElement><text><![CDATA[Admission No]]></text></staticText>
            <staticText><reportElement x="200" y="0" width="100" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font isBold="true" size="11"/></textElement><text><![CDATA[First Name]]></text></staticText>
            <staticText><reportElement x="300" y="0" width="100" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font isBold="true" size="11"/></textElement><text><![CDATA[Last Name]]></text></staticText>
            <staticText><reportElement x="400" y="0" width="80" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font isBold="true" size="11"/></textElement><text><![CDATA[Academic Year]]></text></staticText>
            <staticText><reportElement x="480" y="0" width="100" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font isBold="true" size="11"/></textElement><text><![CDATA[Amount]]></text></staticText>
            <staticText><reportElement x="580" y="0" width="100" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font isBold="true" size="11"/></textElement><text><![CDATA[Payment Mode]]></text></staticText>
            <staticText><reportElement x="680" y="0" width="120" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font isBold="true" size="11"/></textElement><text><![CDATA[Reference Number]]></text></staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="26">
            <textField pattern="yyyy-MM-dd HH:mm:ss"><reportElement x="0" y="0" width="100" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font size="10"/></textElement><textFieldExpression><![CDATA[$F{transaction_date}]]></textFieldExpression></textField>
            <textField><reportElement x="100" y="0" width="100" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font size="10"/></textElement><textFieldExpression><![CDATA[$F{admission_no}]]></textFieldExpression></textField>
            <textField><reportElement x="200" y="0" width="100" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font size="10"/></textElement><textFieldExpression><![CDATA[$F{first_name}]]></textFieldExpression></textField>
            <textField><reportElement x="300" y="0" width="100" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font size="10"/></textElement><textFieldExpression><![CDATA[$F{last_name}]]></textFieldExpression></textField>
            <textField><reportElement x="400" y="0" width="80" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font size="10"/></textElement><textFieldExpression><![CDATA[$F{academic_year}]]></textFieldExpression></textField>
            <textField><reportElement x="480" y="0" width="100" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font size="10"/></textElement><textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression></textField>
            <textField><reportElement x="580" y="0" width="100" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font size="10"/></textElement><textFieldExpression><![CDATA[$F{payment_mode}]]></textFieldExpression></textField>
            <textField><reportElement x="680" y="0" width="120" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font size="10"/></textElement><textFieldExpression><![CDATA[$F{reference_number}]]></textFieldExpression></textField>
        </band>
    </detail>
</jasperReport>
