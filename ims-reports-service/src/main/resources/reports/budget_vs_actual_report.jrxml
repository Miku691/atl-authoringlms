            <textField><reportElement x="100" y="0" width="200" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font size="10"/></textElement><textFieldExpression><![CDATA[$F{category_name}]]></textFieldExpression></textField>
            <textField><reportElement x="300" y="0" width="120" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font size="10"/></textElement><textFieldExpression><![CDATA[$F{allocated_amount}]]></textFieldExpression></textField>
            <textField><reportElement x="420" y="0" width="120" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font size="10"/></textElement><textFieldExpression><![CDATA[$F{spent_amount}]]></textFieldExpression></textField>
