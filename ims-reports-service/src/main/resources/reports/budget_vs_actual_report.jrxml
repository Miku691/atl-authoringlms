            <staticText><reportElement x="660" y="0" width="100" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font isBold="true" size="11"/></textElement><text><![CDATA[Utilization (%)]]></text></staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="26">
