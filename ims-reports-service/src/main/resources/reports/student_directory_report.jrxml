    <property name="net.sf.jasperreports.export.xls.font.size.fix.enabled" value="false"/>

    <parameter name="param_tenant_id" class="java.lang.String"/>
    <queryString>
        <![CDATA[SELECT student_id, admission_no, first_name, last_name, email, phone, gender, student_status, roll_no, academic_year, offering_name, offering_type FROM v_student_directory WHERE tenant_id = $P{param_tenant_id}]]>
    </queryString>
    <field name="admission_no" class="java.lang.String"/>
