    <property name="net.sf.jasperreports.export.xls.font.size.fix.enabled" value="false"/>

    <parameter name="param_tenant_id" class="java.lang.String"/>
    <queryString>
        <![CDATA[SELECT offering_id, offering_name, offering_type, capacity, start_date, end_date, program_code, program_title, program_level FROM v_academic_offerings WHERE tenant_id = $P{param_tenant_id}]]>
    </queryString>
