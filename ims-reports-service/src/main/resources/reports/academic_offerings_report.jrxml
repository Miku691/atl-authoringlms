    <field name="program_code" class="java.lang.String"/>
    <field name="program_title" class="java.lang.String"/>
    <field name="program_level" class="java.lang.String"/>
    <columnHeader>
        <band height="26">
            <staticText><reportElement x="0" y="0" width="120" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font isBold="true" size="11"/></textElement><text><![CDATA[Offering Name]]></text></staticText>
            <staticText><reportElement x="120" y="0" width="100" height="26"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box><textElement verticalAlignment="Middle"><font isBold="true" size="11"/></textElement><text><![CDATA[Type]]></text></staticText>
